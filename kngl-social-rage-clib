<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>KNGL Social & Community Portal</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        body { background-color: #0b0e14; color: #f1f5f9; min-height: 100vh; display: flex; flex-direction: column; }
        
        /* Navigation Bar */
        navbar { background: #0f172a; border-bottom: 2px solid #ef4444; position: sticky; top: 0; z-index: 1000; display: flex; justify-content: space-between; align-items: center; padding: 0.8rem 1.5rem; flex-wrap: wrap; }
        .logo { font-weight: bold; font-size: 1.4rem; color: #ef4444; text-transform: uppercase; letter-spacing: 1px; cursor: pointer; }
        .nav-links { display: flex; gap: 0.8rem; list-style: none; flex-wrap: wrap; }
        .nav-links a { color: #cbd5e1; text-decoration: none; font-size: 0.85rem; font-weight: 600; padding: 0.4rem 0.8rem; border-radius: 6px; transition: 0.2s; cursor: pointer; }
        .nav-links a:hover, .nav-links a.active { background: #ef4444; color: #fff; }
        .online-counter { background: #1e293b; padding: 0.4rem 0.8rem; border-radius: 20px; border: 1px solid #334155; font-size: 0.85rem; color: #22c55e; display: flex; align-items: center; gap: 6px; }
        .online-dot { width: 8px; height: 8px; background: #22c55e; border-radius: 50%; display: inline-block; animation: pulse 1.5s infinite; }
        @keyframes pulse { 0% { opacity: 1; } 50% { opacity: 0.3; } 100% { opacity: 1; } }

        /* Container & Sections */
        .container { max-width: 1100px; margin: 1.5rem auto; padding: 0 1rem; width: 100%; flex: 1; }
        .section { display: none; }
        .section.active { display: block; }
        h2 { font-size: 1.4rem; color: #ef4444; margin-bottom: 1rem; border-bottom: 1px solid #334155; padding-bottom: 0.5rem; display: flex; justify-content: space-between; align-items: center; }

        /* General UI Elements */
        .card { background: #1e293b; border-radius: 12px; padding: 1.2rem; border: 1px solid #334155; margin-bottom: 1rem; }
        .btn { background: #ef4444; color: #fff; border: none; padding: 0.5rem 1rem; border-radius: 8px; cursor: pointer; font-weight: bold; font-size: 0.85rem; transition: 0.2s; }
        .btn:hover { background: #dc2626; }
        .btn-secondary { background: #334155; }
        .btn-secondary:hover { background: #475569; }
        .btn-gift { background: #5356ff; }
        .btn-super { background: #eab308; color: #000; }
        
        /* User Avatar & Badges */
        .avatar { width: 42px; height: 42px; border-radius: 50%; object-fit: cover; border: 2px solid #ef4444; }
        .badge { font-size: 0.65rem; padding: 0.2rem 0.4rem; border-radius: 4px; font-weight: bold; text-transform: uppercase; margin-left: 0.3rem; }
        .role-owner { background: #dc2626; color: #fff; }
        .role-mod { background: #ea580c; color: #fff; }
        .role-user { background: #475569; color: #fff; }

        /* Twitter / Social Feed */
        .social-post-box { background: #1e293b; border-radius: 12px; padding: 1rem; border: 1px solid #334155; margin-bottom: 1.5rem; }
        .social-post-box textarea { width: 100%; background: #0f172a; border: 1px solid #334155; border-radius: 8px; padding: 0.8rem; color: #fff; resize: none; margin-bottom: 0.8rem; font-size: 0.9rem; }
        .post-actions { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; }
        .post-input-file { font-size: 0.8rem; color: #94a3b8; }
        .feed-post { background: #1e293b; border-radius: 12px; border: 1px solid #334155; padding: 1rem; margin-bottom: 1rem; }
        .post-header { display: flex; align-items: center; gap: 0.8rem; margin-bottom: 0.8rem; }
        .post-media { width: 100%; max-height: 400px; border-radius: 8px; object-fit: cover; margin: 0.8rem 0; background: #000; }
        .post-footer-actions { display: flex; gap: 1rem; border-top: 1px solid #334155; pt: 0.8rem; margin-top: 0.8rem; font-size: 0.85rem; }
        .action-item { cursor: pointer; color: #cbd5e1; display: flex; align-items: center; gap: 0.3rem; transition: 0.2s; }
        .action-item:hover { color: #ef4444; }

        /* Kick Style Chat */
        .chat-wrapper { display: grid; grid-template-columns: 3fr 1fr; gap: 1rem; height: 520px; }
        .chat-box { background: #1e293b; border-radius: 12px; border: 1px solid #334155; display: flex; flex-direction: column; }
        .chat-messages { flex: 1; padding: 1rem; overflow-y: auto; display: flex; flex-direction: column; gap: 0.6rem; }
        .chat-message { font-size: 0.9rem; background: #0f172a; padding: 0.6rem 0.8rem; border-radius: 8px; border-left: 3px solid #ef4444; }
        .emoji-picker { display: flex; gap: 0.4rem; padding: 0.5rem; background: #0f172a; border-top: 1px solid #334155; overflow-x: auto; }
        .emoji-btn { background: #1e293b; border: 1px solid #334155; padding: 0.3rem 0.5rem; border-radius: 6px; cursor: pointer; font-size: 0.9rem; color: #fff; }
        .emoji-btn:hover { background: #ef4444; }
        .chat-input-area { padding: 0.8rem; border-top: 1px solid #334155; display: flex; gap: 0.5rem; }
        .chat-input-area input { flex: 1; background: #0f172a; border: 1px solid #334155; padding: 0.6rem; color: #fff; border-radius: 8px; }

        /* Direct Messaging (WhatsApp Style) */
        .dm-wrapper { display: grid; grid-template-columns: 1fr 2fr; gap: 1rem; height: 480px; }
        .dm-users { background: #1e293b; border-radius: 12px; border: 1px solid #334155; overflow-y: auto; }
        .dm-user-item { padding: 0.8rem; border-bottom: 1px solid #334155; cursor: pointer; display: flex; align-items: center; gap: 0.8rem; }
        .dm-user-item:hover, .dm-user-item.active { background: #0f172a; }
        .dm-chat-area { background: #1e293b; border-radius: 12px; border: 1px solid #334155; display: flex; flex-direction: column; }
        .dm-messages { flex: 1; padding: 1rem; overflow-y: auto; display: flex; flex-direction: column; gap: 0.5rem; }

        /* Profile Customization */
        .profile-container { display: grid; grid-template-columns: 1fr 2fr; gap: 1.5rem; }
        .form-group { margin-bottom: 1rem; }
        .form-group label { display: block; margin-bottom: 0.3rem; font-size: 0.85rem; color: #cbd5e1; }
        .form-group input { width: 100%; padding: 0.6rem; background: #0f172a; border: 1px solid #334155; color: #fff; border-radius: 8px; }

        /* Grid Layouts */
        .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1rem; }
    </style>
</head>
<body>

    <navbar>
        <div class="logo" onclick="showSection('social')">KNGL Portal</div>
        <ul class="nav-links">
            <li><a onclick="showSection('social')" class="active">KNGL Social</a></li>
            <li><a onclick="showSection('kiz-ekibi')">Kız Ekibi Rage</a></li>
            <li><a onclick="showSection('chat')">Kick Canlı Chat</a></li>
            <li><a onclick="showSection('dm')">Özel Mesajlar (DM)</a></li>
            <li><a onclick="showSection('ekip')">KNGL Ekip</a></li>
            <li><a onclick="showSection('jrokez')">Jrokez Anıları</a></li>
            <li><a onclick="showSection('profile')">Profilim</a></li>
        </ul>
        <div class="online-counter">
            <span class="online-dot"></span>
            <span id="active-users">42</span> Aktif Kullanıcı
        </div>
    </navbar>

    <div class="container">

        <!-- KNGL Social Feed (Twitter / X Mantığı) -->
        <div id="social" class="section active">
            <h2>KNGL Social (Topluluk Akışı)</h2>
            <div class="social-post-box">
                <textarea id="post-text" rows="3" placeholder="Aklından ne geçiyor? Video URL, resim URL veya editi buraya yaz..."></textarea>
                <div class="post-actions">
                    <div style="display:flex; gap:0.5rem; align-items:center;">
                        <input type="text" id="post-media-url" placeholder="Görsel / Video URL (Opsiyonel)" style="background:#0f172a; border:1px solid #334155; color:#fff; padding:0.4rem; border-radius:6px; font-size:0.8rem; width:220px;">
                        <input type="file" id="post-file-input" accept="image/*,video/*" class="post-input-file" onchange="handleFileSelect(event)">
                    </div>
                    <button class="btn" onclick="createPost()">Paylaş</button>
                </div>
            </div>
            <div id="social-feed">
                <!-- Dinamik Gönderiler Buraya Eklenecek -->
            </div>
        </div>

        <!-- Kız Ekibi Rage -->
        <div id="kiz-ekibi" class="section">
            <h2>KNGL Kız Ekibi</h2>
            <div class="grid">
                <div class="card"><h3>zehragn</h3><p class="badge role-user">Kız Ekibi</p><button class="btn btn-secondary" style="margin-top:0.8rem;" onclick="followUser('zehragn')">Takip Et</button></div>
                <div class="card"><h3>cansu</h3><p class="badge role-user">Kız Ekibi</p><button class="btn btn-secondary" style="margin-top:0.8rem;" onclick="followUser('cansu')">Takip Et</button></div>
                <div class="card"><h3>mediss</h3><p class="badge role-user">Kız Ekibi</p><button class="btn btn-secondary" style="margin-top:0.8rem;" onclick="followUser('mediss')">Takip Et</button></div>
                <div class="card"><h3>hilalq</h3><p class="badge role-user">Kız Ekibi</p><button class="btn btn-secondary" style="margin-top:0.8rem;" onclick="followUser('hilalq')">Takip Et</button></div>
            </div>
        </div>

        <!-- Kick Canlı Chat & Emojiler -->
        <div id="chat" class="section">
            <h2>Kick Tarzı Canlı Chat</h2>
            <div class="chat-wrapper">
                <div class="chat-box">
                    <div class="chat-messages" id="chat-messages">
                        <div class="chat-message"><strong>[SİSTEM]:</strong> Canlı sohbet odasına bağlandınız.</div>
                    </div>
                    <div class="emoji-picker">
                        <button class="emoji-btn" onclick="addEmoji('🔥')">🔥 Rage</button>
                        <button class="emoji-btn" onclick="addEmoji('👑')">👑 King</button>
                        <button class="emoji-btn" onclick="addEmoji('😂')">😂 LUL</button>
                        <button class="emoji-btn" onclick="addEmoji('💀')">💀 Dead</button>
                        <button class="emoji-btn" onclick="addEmoji('💯')">💯 100</button>
                        <button class="emoji-btn" onclick="addEmoji('🐐')">🐐 GOAT</button>
                    </div>
                    <div class="chat-input-area">
                        <input type="text" id="chat-input" placeholder="Chat'e bir şeyler yazın...">
                        <button class="btn" onclick="sendChatMessage()">Gönder</button>
                    </div>
                </div>
                <div class="card">
                    <h3>Puanım: <span id="user-points" style="color:#eab308;">150</span> B</h3>
                    <p style="font-size:0.8rem; color:#94a3b8; margin:0.5rem 0;">Her 1 dakikada 50 Puan kazanırsınız.</p>
                    <button class="btn btn-gift" style="width:100%; margin-bottom:0.5rem;" onclick="sendGift(100)">100 Puan: Hediye At</button>
                    <button class="btn btn-super" style="width:100%;" onclick="sendGift(500)">500 Puan: Super Like At</button>
                </div>
            </div>
        </div>

        <!-- Özel Mesajlaşma (DM) -->
        <div id="dm" class="section">
            <h2>Özel Mesajlar (DM)</h2>
            <div class="dm-wrapper">
                <div class="dm-users" id="dm-users-list">
                    <div class="dm-user-item active" onclick="openDMChat('ErayCan')">
                        <strong>ErayCan</strong>
                    </div>
                    <div class="dm-user-item" onclick="openDMChat('KadirFirat')">
                        <strong>KadirFirat</strong>
                    </div>
                </div>
                <div class="dm-chat-area">
                    <div class="dm-messages" id="dm-messages">
                        <div class="chat-message"><strong>ErayCan:</strong> Selam kankam portala hoş geldin!</div>
                    </div>
                    <div class="chat-input-area">
                        <input type="text" id="dm-input" placeholder="Özel mesaj gönder...">
                        <button class="btn" onclick="sendDMMessage()">Gönder</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- KNGL Ekip Listesi -->
        <div id="ekip" class="section">
            <h2>KNGL Ekip Üyeleri</h2>
            <div class="grid" id="team-grid"></div>
        </div>

        <!-- Jrokez Anı Köşesi -->
        <div id="jrokez" class="section">
            <h2>Jrokez (Ali Kaan) Anı Köşesi</h2>
            <div class="card" style="text-align:center; border-color:#ef4444;">
                <h3 style="color:#ef4444; font-size:1.5rem;">1 Sene Olsa Bile Seni Unutmayacağız</h3>
                <p style="margin-top:0.5rem; color:#cbd5e1;">Mekanın Cennet Olsun Jrokez. Kalbimizdesin.</p>
            </div>
        </div>

        <!-- Profil Ayarları -->
        <div id="profile" class="section">
            <h2>Profil Ayarları</h2>
            <div class="profile-container">
                <div class="card" style="text-align:center;">
                    <img id="preview-avatar" src="https://api.dicebear.com/7.x/bottts/svg?seed=user" class="avatar" style="width:100px; height:100px; margin-bottom:1rem;">
                    <h3 id="profile-card-name">Kullanıcı</h3>
                    <p id="profile-card-nick" style="color:#94a3b8; font-size:0.85rem;">@user123</p>
                </div>
                <div class="card">
                    <div class="form-group">
                        <label>Görünen Ad:</label>
                        <input type="text" id="prof-name" value="Kullanıcı">
                    </div>
                    <div class="form-group">
                        <label>Kullanıcı Adı (Nick):</label>
                        <input type="text" id="prof-nick" value="user123">
                    </div>
                    <div class="form-group">
                        <label>Profil Fotoğrafı (Resim URL):</label>
                        <input type="text" id="prof-avatar-url" placeholder="https://... (Eray fotosu vb. yapıştırabilirsin)">
                    </div>
                    <div class="form-group">
                        <label>Veya Galeriden / Dosyadan Seç:</label>
                        <input type="file" id="prof-avatar-file" accept="image/*" onchange="handleAvatarFile(event)">
                    </div>
                    <button class="btn" onclick="saveProfile()">Profili Güncelle</button>
                </div>
            </div>
        </div>

    </div>

    <script>
        let currentUser = {
            name: "Kullanıcı",
            nick: "user123",
            avatar: "https://api.dicebear.com/7.x/bottts/svg?seed=user",
            points: 150
        };

        let tempUploadedMedia = "";

        // Tab Navigation
        function showSection(id) {
            document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
            document.querySelectorAll('.nav-links a').forEach(a => a.classList.remove('active'));
            document.getElementById(id).classList.add('active');
            if(event && event.target && event.target.tagName === 'A') {
                event.target.classList.add('active');
            }
        }

        // Profile Management
        function handleAvatarFile(e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(evt) {
                    currentUser.avatar = evt.target.result;
                    document.getElementById('preview-avatar').src = currentUser.avatar;
                };
                reader.readAsDataURL(file);
            }
        }

        function saveProfile() {
            const nameInput = document.getElementById('prof-name').value;
            const nickInput = document.getElementById('prof-nick').value;
            const urlInput = document.getElementById('prof-avatar-url').value;

            if (nameInput) currentUser.name = nameInput;
            if (nickInput) currentUser.nick = nickInput;
            if (urlInput) currentUser.avatar = urlInput;

            document.getElementById('preview-avatar').src = currentUser.avatar;
            document.getElementById('profile-card-name').innerText = currentUser.name;
            document.getElementById('profile-card-nick').innerText = "@" + currentUser.nick;

            alert("Profiliniz başarıyla güncellendi!");
        }

        // Social Feed Mechanics (Twitter / X)
        function handleFileSelect(e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(evt) {
                    tempUploadedMedia = evt.target.result;
                };
                reader.readAsDataURL(file);
            }
        }

        function createPost() {
            const text = document.getElementById('post-text').value;
            const urlMedia = document.getElementById('post-media-url').value;
            const media = tempUploadedMedia || urlMedia;

            if (!text && !media) {
                alert("Lütfen bir yazı veya medya ekleyin!");
                return;
            }

            const feed = document.getElementById('social-feed');
            const post = document.createElement('div');
            post.className = 'feed-post';
            
            let mediaHtml = '';
            if (media) {
                if (media.includes('video') || media.endsWith('.mp4')) {
                    mediaHtml = `<video src="${media}" controls class="post-media"></video>`;
                } else {
                    mediaHtml = `<img src="${media}" class="post-media">`;
                }
            }

            post.innerHTML = `
                <div class="post-header">
                    <img src="${currentUser.avatar}" class="avatar">
                    <div>
                        <strong>${currentUser.name}</strong> <span style="color:#94a3b8; font-size:0.8rem;">@${currentUser.nick}</span>
                    </div>
                </div>
                <p style="font-size:0.95rem; line-height:1.4;">${text}</p>
                ${mediaHtml}
                <div class="post-footer-actions">
                    <span class="action-item" onclick="likePost(this)">❤️ <span class="like-count">0</span> Beğeni</span>
                    <span class="action-item" onclick="superLikePost(this)">⭐ Super Like</span>
                    <span class="action-item" onclick="sharePost()">🔄 Paylaş</span>
                    <span class="action-item" onclick="favPost(this)">📌 Favorile</span>
                </div>
            `;

            feed.prepend(post);
            document.getElementById('post-text').value = '';
            document.getElementById('post-media-url').value = '';
            tempUploadedMedia = "";
        }

        function likePost(el) {
            let countEl = el.querySelector('.like-count');
            countEl.innerText = parseInt(countEl.innerText) + 1;
        }

        function superLikePost(el) {
            alert("Super Like gönderildi! ⭐");
        }

        function sharePost() {
            alert("Gönderi bağlantısı kopyalandı!");
        }

        function favPost(el) {
            alert("Gönderi favorilerinize eklendi.");
        }

        function followUser(username) {
            alert(username + " adlı kullanıcı takip edildi!");
        }

        // Kick Chat System
        function addEmoji(emoji) {
            document.getElementById('chat-input').value += ' ' + emoji;
        }

        function sendChatMessage() {
            const input = document.getElementById('chat-input');
            if (!input.value.trim()) return;

            const chatMessages = document.getElementById('chat-messages');
            const msg = document.createElement('div');
            msg.className = 'chat-message';
            msg.innerHTML = `<strong>[ÜYE] ${currentUser.name}:</strong> ${input.value}`;
            chatMessages.appendChild(msg);
            chatMessages.scrollTop = chatMessages.scrollHeight;
            input.value = '';
        }

        function sendGift(cost) {
            if (currentUser.points >= cost) {
                currentUser.points -= cost;
                document.getElementById('user-points').innerText = currentUser.points;
                alert(cost + " puan değerinde hediye chate gönderildi!");
            } else {
                alert("Yetersiz puan!");
            }
        }

        // Direct Messaging (DM)
        let activeDMUser = "ErayCan";
        function openDMChat(user) {
            activeDMUser = user;
            document.querySelectorAll('.dm-user-item').forEach(u => u.classList.remove('active'));
            event.currentTarget.classList.add('active');
            document.getElementById('dm-messages').innerHTML = `<div class="chat-message"><strong>${activeDMUser}:</strong> Sohbet başlatıldı.</div>`;
        }

        function sendDMMessage() {
            const input = document.getElementById('dm-input');
            if (!input.value.trim()) return;

            const dmMessages = document.getElementById('dm-messages');
            const msg = document.createElement('div');
            msg.className = 'chat-message';
            msg.innerHTML = `<strong>Sen -> ${activeDMUser}:</strong> ${input.value}`;
            dmMessages.appendChild(msg);
            dmMessages.scrollTop = dmMessages.scrollHeight;
            input.value = '';
        }

        // Render Team Members
        const teamMembers = [
            "ayberk babur", "hobbitemo", "ebenivon", "niyazi küçük", "sercan zurna", 
            "minik", "dızcı umut", "xhzali", "rahmican", "maxers", "order", 
            "kadirfırat", "apocalpser", "ahmetturku", "barisytb", "falcon", 
            "barankusss", "kendine müzisyen", "flomere"
        ];
        
        const teamGrid = document.getElementById('team-grid');
        teamMembers.forEach(member => {
            const card = document.createElement('div');
            card.className = 'card';
            card.innerHTML = `<h3>${member}</h3><p class="badge role-user">KNGL Ekibi</p><button class="btn btn-secondary" style="margin-top:0.8rem; width:100%;" onclick="followUser('${member}')">Takip Et</button>`;
            teamGrid.appendChild(card);
        });

        // Points Accumulator (Every 1 minute)
        setInterval(() => {
            currentUser.points += 50;
            document.getElementById('user-points').innerText = currentUser.points;
        }, 60000);
    </script>
</body>
</html>
